{
  "Environment": "development",
  "AllowedHosts": "*",
  "DrnContext_DevHost": "postgresql-rw",
  "DrnContext_DevPort": 5432,
  "DrnContext_DevUsername": "drn",
  "DrnContext_DevDatabase": "drnDb",
  "NexusAppSettings": {
    "AppId": 0,
    "AppInstanceId": 0,
    "NexusAddress": "nexus"
  },
  "DrnAppFeatures": {
    "InternalRequestHttpVersion": "2.0"
  },
  "DrnDevelopmentSettings": {
    "AutoMigrateDevelopment": true,
    "LaunchExternalDependencies": false,
    "Prototype": false
  },
  "Kestrel": {
    "Docs": "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/servers/kestrel/endpoints#configure-http-protocols",
    "EndpointDefaults": {
      "Protocols": "Http1"
    },
    "Endpoints": {
      "All": {
        "Url": "http://*:5998"
      }
    }
  },
  "HostOptions": {
    "ShutdownTimeout": "00:00:15",
    "StartupTimeout": "00:00:15",
    "ServicesStartConcurrently": true,
    "ServicesStopConcurrently": true,
    "BackgroundServiceExceptionBehavior": "StopHost"
  },
  "NLog": {
    "targets": {
      "graylog-http": {
        "address": "http://drn-gelf.graylog:12201/gelf"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console, graylog-http, file"
      }
    ]
  }
}
